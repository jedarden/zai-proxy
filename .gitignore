# Binaries
proxy/zai-proxy
dashboard/zai-proxy-dashboard
*.exe

# Build artifacts
proxy/bin/
dashboard/bin/
dashboard/frontend/dist/

# Go
vendor/

# Node
node_modules/
npm-debug.log*

# Beads
# Bead store: SQLite and history stay local; the JSONL checkpoint is tracked.
# Must be `.beads/*`, not `.beads/` — git cannot re-include a file whose
# parent directory is excluded.
.beads/*
!.beads/issues.jsonl

# Test output artifacts
test-output*.txt
test-output*.log
*.log
/test-results/

# BD completion summaries (belong in beads)
BD-*.md
bd-*.md

# Misc
.DS_Store

# bead-rs store: the durable artefact is the checkpoint plus config.json.
# (`beads.db` stays ignored — it is per-machine live state.)
!.beads/checkpoint/
!.beads/checkpoint/**
!.beads/config.json

# Local NEEDLE and bead runtime state
.needle-predispatch-sha
.beads/events.jsonl
.beads/heartbeats.jsonl
.beads/diagnostics/
.beads/logs/
.beads/traces/
.beads/receipts/
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
.beads/*.db.backup.*
.beads/*.lock
.beads/*.tmp
.beads/*.temp
.beads/*.journal
.br_recovery/
